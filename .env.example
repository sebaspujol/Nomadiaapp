# ============================================
# NOMADIA - Variables de entorno
# Copiá este archivo como .env.local
# ============================================

# --- BASE DE DATOS (Supabase - gratis) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- NEXTAUTH ---
NEXTAUTH_SECRET="tu-secret-super-largo-aqui"
NEXTAUTH_URL="http://localhost:3000"

# --- GOOGLE OAuth (para login con Gmail) ---
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# --- MAPA, GEOCODING Y BÚSQUEDA DE LUGARES ---
# Ya no usamos Google Maps/Places/Geocoding para nada de esto — el mapa usa
# Leaflet + tiles de OpenStreetMap, la búsqueda de ciudad usa Nominatim, y el
# import de lugares nuevos usa Overpass API. Los tres son gratis para
# siempre, sin API key y sin tarjeta de crédito. No hace falta ninguna
# variable de entorno para esto.

# Por defecto la app SÍ importa lugares nuevos de OpenStreetMap cuando
# alguien busca una zona sin datos (a diferencia de antes con Google, ahora
# es gratis así que no hay riesgo de costo en dejarlo activado). Si alguna
# vez el servicio público de Overpass está lento/caído y preferís que la app
# dependa solo de lo ya sembrado a mano, poné esto en "false".
ENABLE_LIVE_PLACE_IMPORT="true"

# --- ANTHROPIC (para leer menús con IA) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- ADMIN ---
# Emails (separados por coma) que pueden ver el dashboard de métricas en /admin.
# Tienen que ser el mismo email con el que esa persona se loguea en Nomadia.
ADMIN_EMAILS="spujol@riamoneytransfer.com"
